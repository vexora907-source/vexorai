{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mi-portafolio-empresarial",
  "version": "0.1.0",
  "identifier": "com.example.mi-portafolio-empresarial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mi Portafolio Empresarial",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
